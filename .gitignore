# Go binaries and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Bundled nrfutil ships inside the release zips; keep it despite *.exe above.
!3rd/nrfutil.exe

# Test and coverage artifacts
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# Build output
/build/
/dist/
/nrf-factory

# Local Go workspace and environment
go.work
go.work.sum
.env
.env.*
!.env.example

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Firmware — external per design, never commit (proprietary images)
*.hex
/test/

# Node / Playwright (UI functional tests)
/node_modules/
/tests/.bin/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# other
.specstory
.codegraph/
