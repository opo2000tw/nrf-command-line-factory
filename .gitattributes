# Normalize text files to LF in the repository and working tree.
* text=auto eol=lf

# Keep Windows command scripts in their native line-ending format.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never apply text conversion to binary artifacts.
*.bin binary
*.dll binary
*.elf binary
*.exe binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.png binary
*.syso binary
*.uf2 binary
*.zip binary
